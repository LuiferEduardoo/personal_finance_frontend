# Endpoint GraphQL del backend. Punto de entrada de casi toda la API.
VITE_GRAPHQL_ENDPOINT=http://localhost:3000/graphql

# Base de la API REST (solo el análisis de facturas: /invoices/*).
# Si se omite, se deriva del endpoint de GraphQL quitándole /graphql.
# VITE_API_BASE_URL=http://localhost:3000
